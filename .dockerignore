# Keep the image small and free of machine-specific state or secrets.
venv/
.venv/
.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/

# Local data - the real database is bind-mounted at runtime, never baked in.
db.sqlite3
db.sqlite3.*
media/
staticfiles/

# Secrets and local overrides.
.env
.env.*
!.env.example

# Logs and editor/OS noise.
*.log
.DS_Store
Thumbs.db
