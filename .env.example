# Copy to .env and adjust. Development is zero-config: every value below can be
# omitted. Production (ENVIRONMENT=production) fails fast at startup unless the
# required values are explicit. See DEPLOYMENT.md.
#
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Core ---
# development (default) or production. Production implies DEBUG=False and
# enables HTTPS redirects, secure cookies, a one-hour HSTS and production CSP
# defaults. Invalid values stop Django before it serves a request.
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings
# Development falls back to a checked-in insecure key. Production requires a
# random value of at least 50 characters; placeholders are rejected.
SECRET_KEY=replace-with-a-random-50-character-string
DEBUG=True

# --- Hosts and CORS ---
# Comma-separated. ALLOWED_HOSTS must be set when DEBUG=False or
# ENVIRONMENT=production; wildcard "*" and values with a scheme/path are
# rejected. These deployment values are not editable through Admin Settings.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Production defaults to none (same-origin SPA); list the real https origin
# when the frontend is hosted elsewhere. Wildcards are not accepted here.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional reference for operators/frontends; not read by Django settings.
# FRONTEND_URL=https://your-frontend.vercel.app
# Leave False while using JWT bearer tokens; set True only for cookie auth.
CORS_ALLOW_CREDENTIALS=False
# Needed for unsafe methods (POST/PATCH/DELETE) under CSRF protection. Use the
# public origin(s), e.g. https://ctf.example.com. Django also supports
# https://*.example.com here, but not wildcards in CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=
# True when a TLS-terminating reverse proxy sets X-Forwarded-Proto. Production
# defaults to True; set False only when Django itself terminates TLS.
TRUST_PROXY_HEADERS=True

# --- Database ---
# SQLite is the default for local development. PostgreSQL is required for
# production Docker/Render deployments.
#
# Option 1: DATABASE_URL (recommended for Render/managed PostgreSQL)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
#
# Option 2: Individual variables
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=5
# DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
# Django runs on the host, so it reaches Redis through the localhost-published
# port. The Docker worker and Beat override this with redis://redis:6379/0.
# REDIS_URL is not read by settings; configure the explicit variables below.
# REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Shared cache for DRF throttle counters. Leave blank in development (per-process
# local-memory cache). Production requires CACHE_URL, using a different Redis
# database/instance from the broker so cache eviction cannot drop task messages.
# CACHE_URL=redis://127.0.0.1:6379/1
# Optional. Leave blank to store no results at all (the default): task success
# is verified from the worker log. Setting a backend also turns result storage
# on, so `manage.py enqueue_heartbeat --wait` can return a value.
CELERY_RESULT_BACKEND=
# Seconds between Celery Beat heartbeats (the only scheduled job).
CELERY_HEARTBEAT_INTERVAL_SECONDS=60
# The existing heartbeat records an idempotent timestamp in Redis so
# /health/celery/ can distinguish a ticking Beat from a running container.
CELERY_HEARTBEAT_TRACKING_ENABLED=True
CELERY_HEARTBEAT_KEY_PREFIX=flaghunt:ops:heartbeat
# Delete the marker after this many seconds. Keep it at least three Beat
# intervals so a single missed tick is not immediately reported as stale.
CELERY_HEARTBEAT_TTL_SECONDS=180
# A Beat marker older than this is reported stale/unhealthy.
CELERY_BEAT_STALE_AFTER_SECONDS=180
# Timeout for the Redis ping and Celery worker control ping.
CELERY_HEALTH_TIMEOUT_SECONDS=2

# --- Local Docker challenge runtime (Stage 1C) ---
# Leave the endpoint blank to use the active Docker CLI context (Docker Desktop
# on Windows/macOS or /var/run/docker.sock on Linux). Set it only when the
# backend must target a non-default endpoint.
# FLAGHUNT_DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine
FLAGHUNT_DOCKER_TIMEOUT=60
FLAGHUNT_INSTANCE_DURATION_MINUTES=60
FLAGHUNT_PUBLISH_HOST=127.0.0.1
FLAGHUNT_CONTAINER_STOP_TIMEOUT=10
# Seconds between Celery Beat cleanup/reconciliation runs.
CELERY_INSTANCE_CLEANUP_INTERVAL_SECONDS=60

# --- JWT lifetimes and revocation ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=1
# Rotate on every refresh and blacklist the previous refresh token. Keep both
# enabled unless a client cannot persist a rotated refresh token.
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_UPDATE_LAST_LOGIN=True

# --- Application rate limits (per the scope described in the README) ---
# These are application limits, not a substitute for a reverse-proxy/WAF limit.
DRF_THROTTLE_LOGIN=5/minute
DRF_THROTTLE_REGISTER=5/hour
DRF_THROTTLE_TOKEN_REFRESH=10/minute
DRF_THROTTLE_FLAG_SUBMIT=5/minute
DRF_THROTTLE_HINT_REVEAL=20/minute
DRF_THROTTLE_PASSWORD_CHANGE=5/minute
DRF_THROTTLE_TERMINAL_TICKET=10/minute
# 0 ignores X-Forwarded-For. Set to the number of trusted proxies only when
# that header is overwritten by your proxy; otherwise it is client-controlled.
DRF_NUM_PROXIES=0

# --- Security headers and CSP ---
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
# Keep HTTPS enforcement off for local HTTP development. Production defaults
# all of these on and rejects an insecure override; only set them explicitly
# for a non-production HTTPS test environment.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# Both remain opt-in in production: they can be difficult to undo. Raise the
# HSTS window after verifying HTTPS, including subdomains, then preload.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Report-only first. Review browser reports, tighten CSP_POLICY, then set
# CSP_REPORT_ONLY=False. Development defaults include localhost origins;
# production defaults exclude them and validation rejects a policy that still
# contains localhost or plain-http sources.
CSP_REPORT_ONLY=True
# CSP_POLICY=default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# --- Terminal gateway (Stage 1D foundation) ---
# Production must set an exact http(s) Origin allowlist; '*' is never accepted.
# Development defaults to the CORS origins plus localhost:8000.
# FLAGHUNT_WS_ALLOWED_ORIGINS=https://ctf.example.com
# Prefer an explicit Redis URL with a dedicated DB; otherwise a /2 DB on the
# configured cache/broker Redis host is used. Without Redis, only an isolated
# local run uses the in-memory channel layer (no cross-worker guarantees).
# FLAGHUNT_CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/2
FLAGHUNT_TERMINAL_ENABLED=True
FLAGHUNT_TERMINAL_TICKET_TTL_SECONDS=30
FLAGHUNT_TERMINAL_MAX_SESSIONS_PER_USER=1
FLAGHUNT_TERMINAL_MAX_SESSIONS_PER_INSTANCE=1
FLAGHUNT_TERMINAL_MAX_FRAME_BYTES=32768
FLAGHUNT_TERMINAL_CLEANUP_INTERVAL_SECONDS=60
# Stage 1D.3 PTY streaming controls. The shell is backend-only; no WebSocket
# frame can select a command, user, container, exec session or host path.
FLAGHUNT_TERMINAL_SHELL=/bin/sh
FLAGHUNT_TERMINAL_INPUT_RATE_BYTES_PER_SECOND=65536
FLAGHUNT_TERMINAL_OUTPUT_RATE_BYTES_PER_SECOND=262144
FLAGHUNT_TERMINAL_OUTPUT_BUFFER_BYTES=1048576
FLAGHUNT_TERMINAL_READ_CHUNK_BYTES=4096
FLAGHUNT_TERMINAL_ROWS_MIN=24
FLAGHUNT_TERMINAL_ROWS_MAX=200
FLAGHUNT_TERMINAL_COLS_MIN=40
FLAGHUNT_TERMINAL_COLS_MAX=300
FLAGHUNT_TERMINAL_RESIZE_RATE_PER_SECOND=4
FLAGHUNT_TERMINAL_SESSION_CHECK_INTERVAL_SECONDS=5
FLAGHUNT_TERMINAL_STALE_SESSION_SECONDS=300

# --- Logging and request correlation ---
# Console logs are always on (Docker and runserver). Set LOG_FILE to also write
# a rotating file; the parent directory must exist and be writable.
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=True
# LOG_FILE=logs/flaghunt.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# --- Docker / Render deployment ---
# Render sets PORT automatically. The Docker entrypoint binds Gunicorn to it.
# PORT=8000
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
# DB wait/check behavior in container startup:
DJANGO_WAIT_FOR_DB=True
DJANGO_COLLECTSTATIC_ON_START=False
DJANGO_RUN_CHECKS=False
DJANGO_RUN_DEPLOY_CHECKS=False

# --- Internationalization and files ---
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
STATIC_ROOT=staticfiles
# Absolute in production (durable mounted volume). A relative path is anchored
# to the backend project root. Never place this on ephemeral container storage.
MEDIA_ROOT=media
# Application-side challenge attachment cap (25 MiB). The reverse proxy should
# enforce a matching request-body limit.
MAX_CHALLENGE_ATTACHMENT_BYTES=26214400

# Not applicable to this project: drf-spectacular and DRF versioning are not
# installed, so SPECTACULAR_* and API_DEFAULT_VERSION/API_ALLOWED_VERSIONS have
# no effect.
#
# Note for Docker: the compose file always overrides DB_NAME with the mounted
# path /data/db.sqlite3 and CELERY_BROKER_URL with the redis service name, so
# the values above only describe a host-only run.